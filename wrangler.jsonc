{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "readukrainian",
  "main": "./src/worker.js",
  "compatibility_date": "2026-06-15",
  "vars": {
    "ADMIN_ENABLED": "true",
    "SPEECH_DAILY_CHARACTER_LIMIT": "4500",
    "SPEECH_CLIENT_DAILY_CHARACTER_LIMIT": "600"
  },
  "routes": [
    {
      "pattern": "readukrainianapp.com",
      "custom_domain": true
    },
    {
      "pattern": "www.readukrainianapp.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Pages and the API need the Worker (www redirect, admin switch, security
    // headers). Scripts, styles, fonts, icons and audio do not, so they are
    // served straight from the asset store without a Worker invocation.
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/fonts/*", "!/icons/*", "!/speech/*"]
  },
  "ratelimits": [
    {
      "name": "SPEECH_RATE_LIMITER",
      "namespace_id": "492017",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LOGIN_RATE_LIMITER",
      "namespace_id": "492018",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "492019",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "LOOKUP_RATE_LIMITER",
      "namespace_id": "492020",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "readukrainian_db",
      "database_id": "dfd9b7b4-9c2a-4848-90a8-59e4e83358dc"
    }
  ]
}
