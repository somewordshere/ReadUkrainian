{
  "name": "readukrainian",
  "version": "0.82.0",
  "private": true,
  "description": "Ukrainian reading practice app deployed as a Cloudflare Worker.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "seed": "node scripts/build-content-seed.mjs",
    "wordstock": "node scripts/build-wordstock.mjs",
    "dictionary:build": "node scripts/dictionary/build-dictionary-seed.mjs",
    "dictionary:build:de": "node scripts/dictionary/build-dictionary-seed.mjs --target de",
    "dictionary:build:linguisto": "node scripts/dictionary/build-linguisto-seed.mjs",
    "dictionary:build-curated": "node scripts/dictionary/build-curated-seed.mjs",
    "speech:plan": "node scripts/speech/generate-speech-assets.mjs --plan",
    "speech:build": "node scripts/speech/generate-speech-assets.mjs --bootstrap",
    "test": "node --test",
    "deploy": "wrangler deploy",
    "check:texts": "node scripts/check-texts.mjs",
    "check:live": "node scripts/check-live-content.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.120.1"
  }
}
