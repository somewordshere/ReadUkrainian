{
  "name": "readukrainian",
  "version": "1.03.0",
  "private": true,
  "description": "Ukrainian reading practice app deployed as a Cloudflare Worker.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "seed": "node scripts/build-content-seed.mjs --json-only",
    "wordstock": "node scripts/build-wordstock.mjs",
    "stress:build": "node scripts/build-stress-map.mjs",
    "dictionary:build": "node scripts/dictionary/build-dictionary-seed.mjs",
    "dictionary:build:de": "node scripts/dictionary/build-dictionary-seed.mjs --target de",
    "dictionary:build:linguisto": "node scripts/dictionary/build-linguisto-seed.mjs",
    "dictionary:build-curated": "node scripts/dictionary/build-curated-seed.mjs",
    "dictionary:review-forms": "node scripts/dictionary/review-forms.mjs",
    "speech:plan": "node scripts/speech/generate-speech-assets.mjs --plan",
    "speech:build": "node scripts/speech/generate-speech-assets.mjs",
    "test": "node --test",
    "deploy": "wrangler deploy",
    "check:texts": "node scripts/check-texts.mjs",
    "check:live": "node scripts/check-live-content.mjs",
    "check:seeds": "node scripts/build-content-seed.mjs --check",
    "check:dictionary": "node scripts/check-dictionary-coverage.mjs",
    "check:release": "node scripts/check-release-files.mjs",
    "check": "npm run check:seeds && npm run check:texts -- --level A1 --quiet && npm run check:texts -- --level A2 --quiet && npm run check:dictionary && npm run check:release && npm test"
  },
  "devDependencies": {
    "wrangler": "^4.120.1"
  }
}
